node_modules/
dist/
*.tsbuildinfo

# Scratch space for the miner: the blobless sparse clone of terraform-provider-aws
# and the miner's own report. Never committed.
tmp/

# ~34 MB `terraform providers schema -json` dump; fetched/copied locally, never committed.
# schemas/PROVIDER_VERSION (the pin groups.json was mined at) IS committed.
schemas/schema.json
schemas/.terraform*

# Build artifacts of the generated group packages. `generated/<group>/{package.json,README.md,
# tsconfig.json,src/}` IS committed (sibling repos commit their `src/` the same way); everything
# jsii and jsii-pacmak write is not.
generated/*/lib/
generated/*/dist/
generated/*/.jsii
generated/*/.warnings.jsii.js
# The monolithic @cdktn/aws assembly (scripts/build-monolith.mjs): a copy of every group's src/
# plus one barrel, compiled by jsii and packed by jsii-pacmak. Wholly derived from `generated/`,
# so nothing in it is committed.
monolith/

# jsii writes this one itself on every compile; the generator does not emit it and nothing reads
# it (these packages are private and never published).
generated/*/.npmignore
