{
  "name": "cdktn-aws",
  "version": "0.0.0",
  "private": true,
  "license": "MPL-2.0",
  "description": "PoC: cdk-terrain provider bindings for terraform-provider-aws, regrouped into service modules",
  "scripts": {
    "baseline": "pnpm --filter @cdktn-aws/aws2cdk exec tsx bin/baseline.ts",
    "bench:js": "node scripts/bench-js-coldstart.mjs",
    "build:fleet": "node scripts/build-fleet.mjs",
    "build:monolith": "node scripts/build-monolith.mjs",
    "check:contract": "node scripts/runtime-contract-diff.mjs",
    "check:go-imports": "node scripts/check-go-module-isolation.mjs",
    "check:go-size": "node scripts/check-go-size.mjs",
    "check:groups": "pnpm --filter @cdktn-aws/check-groups run start",
    "check:imports": "node scripts/check-no-cross-group-imports.mjs",
    "go:consumer": "node scripts/go-consumer.mjs",
    "go:tidy-build": "node scripts/go-tidy-build.mjs",
    "fixture": "node tools/aws2cdk/test/fixtures/extract-fixture.mjs",
    "fixture:check": "node tools/aws2cdk/test/fixtures/extract-fixture.mjs --check",
    "generate": "pnpm --filter @cdktn-aws/aws2cdk exec tsx bin/generate.ts",
    "generate:m1": "pnpm --filter @cdktn-aws/aws2cdk exec tsx bin/generate.ts generated m1",
    "jsii": "node scripts/build-generated.mjs",
    "measure:dedup": "node --max-old-space-size=12288 scripts/measure-struct-dedup.mjs",
    "mine": "pnpm --filter @cdktn-aws/mine-groups run start",
    "pacmak:python": "node scripts/build-monolith.mjs --pacmak python",
    "pacmak:go": "node scripts/build-generated.mjs --pacmak-go",
    "project:go": "node scripts/project-go-size.mjs",
    "release": "node scripts/release.mjs",
    "synth:smoke": "node scripts/synth-smoke.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tools/aws2cdk/tsconfig.json && node scripts/typecheck-generated.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "jsii": "~5.9.53",
    "jsii-pacmak": "^1.140.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  }
}
