{
  "name": "cdktn-aws",
  "version": "0.0.0",
  "private": true,
  "license": "MPL-2.0",
  "description": "PoC: cdk-terrain provider bindings for terraform-provider-aws, regrouped into service modules",
  "scripts": {
    "baseline": "pnpm --filter @cdktn-aws/aws2cdk exec tsx bin/baseline.ts",
    "check:groups": "pnpm --filter @cdktn-aws/check-groups run start",
    "check:imports": "node scripts/check-no-cross-group-imports.mjs",
    "generate": "pnpm --filter @cdktn-aws/aws2cdk exec tsx bin/generate.ts",
    "mine": "pnpm --filter @cdktn-aws/mine-groups run start",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tools/aws2cdk/tsconfig.json && node scripts/typecheck-generated.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "jsii": "~5.9.53",
    "jsii-pacmak": "^1.140.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  }
}
